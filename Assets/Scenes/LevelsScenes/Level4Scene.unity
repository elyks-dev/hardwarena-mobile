  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1d8807ffce3414f9088f3a83d5ffd65a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Level4Manager
  gameScreen: {fileID: 0}
  dialogueTMP: {fileID: 1627081891}
  instructionMessage: Click the correct computer that matches my description!
  nextButton: {fileID: 2079795769}
  nextButtonText: {fileID: 1217178929}
  startLabel: '>> TAP TO START <<'
  nextLabel: '>> TAP TO NEXT <<'
  finishLabel: '>> TAP TO FINISH <<'
  coverImage: {fileID: 407613743}
  questions:
  - button: {fileID: 1821872146}
    dialogue: This computer is designed to provide services to other computers connected
      through a network.
    wrongDialogue: Oops! That's not the one. Look for the tall cabinet with several
      computer units and blinking lights!
    correctDialogue: Excellent! That's a Server! It provides services to client computers
      through a network!
  - button: {fileID: 1151759145}
    dialogue: This computer lies between a mainframe computer and a microcomputer
      in the traditional classification.
    wrongDialogue: Oops! Look for the smaller cabinet-style computer with a screen
      and control panels!
    correctDialogue: Wonderful! That's a Minicomputer! It is a mid-range computer
      system that can support multiple users!
  - button: {fileID: 1484986611}
    dialogue: This computer belongs to the laptop category, but it is smaller and
      generally less expensive.
    wrongDialogue: Not quite! Look for the smaller laptop-like computer!
    correctDialogue: Excellent! That's a Netbook! It's a small and lightweight computer
      designed mainly for basic tasks!
  - button: {fileID: 1967859364}
    dialogue: This mobile computer is handy to use and operates through touchscreen
      technology.
    wrongDialogue: Great job! That's a Tablet! It uses touchscreen technology and
      is easy to carry!
    correctDialogue: Try again! Look for the flat touchscreen device without a permanently
      attached keyboard!
  - button: {fileID: 1760830249}
    dialogue: This computer is miniaturized and optimized for mobile use.
    wrongDialogue: 'Not quite! Clue: It has a Keyboard.'
    correctDialogue: Correct! That's a Laptop! It's a portable computer designed
      for mobile use!
  - button: {fileID: 1186302827}
    dialogue: This computer is small enough to hold in your hand and is traditionally
      known as a palmtop.
    wrongDialogue: Not quite! Look for the small handheld organizer!
    correctDialogue: Fantastic! That's a Personal Digital Assistant, or PDA! It's
      a handheld computer used to organize personal information!
  - button: {fileID: 367113351}
    dialogue: This computer processes information using binary digits, which are
      0 and 1.
    wrongDialogue: Try again! Look for a computer that processes information digitally!
    correctDialogue: Excellent! A Desktop is an example of a Digital Computer because
      it processes information using binary digits!
  - button: {fileID: 174647534}
    dialogue: This computer can process huge amounts of information and support many
      users at the same time.
    wrongDialogue: Not quite! Look for the large computer cabinet beside the supercomputer!
    correctDialogue: Great job! That's a Mainframe Computer! It's commonly used by
      large organizations to process large amounts of data!
  - button: {fileID: 686877274}
    dialogue: This is a personal computer designed to sit on or under a desk. It
      usually has a separate monitor, keyboard, and mouse.
    wrongDialogue: Try again! Look for a computer designed to stay on a desk, with
      a separate monitor, keyboard, and mouse!
    correctDialogue: Correct! A Desktop Computer is a type of microcomputer commonly
      used for school, work, gaming, and everyday tasks!
  - button: {fileID: 810302287}
    dialogue: This is a small computer designed to be worn on the body. It can track
      health, display information, and run applications.
    wrongDialogue: Try again! Look for a small electronic device you can wear on
      your wrist to track your activities and display notifications!
    correctDialogue: Correct! A Smartwatch is an example of a wearable computer because
      it contains computing technology that you can wear on your wrist!
  decoyButtons: []
  correctColor: {r: 0, g: 1, b: 0, a: 1}
  wrongColor: {r: 1, g: 0, b: 0, a: 1}
  defaultColor: {r: 1, g: 1, b: 1, a: 1}
  blinkCount: 3
  blinkInterval: 0.2
  timerTMP: {fileID: 1380296935}
  levelTime: 300
  wrongAnswerPenalty: 5
  timerBlinkDuration: 0.4
